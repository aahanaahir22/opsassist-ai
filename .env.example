# Browser client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/events
NEXT_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=your-spa-client-id
NEXT_PUBLIC_AUTH0_AUDIENCE=https://api.opsassist.ai

# Python service
OPSASSIST_ENVIRONMENT=development
OPSASSIST_DATABASE_URL=postgresql+psycopg://opsassist:opsassist@postgres:5432/opsassist
OPSASSIST_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OPSASSIST_AI_MODE=offline
OPSASSIST_OPENAI_API_KEY=
OPSASSIST_OPENAI_MODEL=gpt-5-mini
OPSASSIST_SCENARIO_SEED=20260829
OPSASSIST_APPROVAL_SIGNING_KEY=replace-with-a-long-random-value
OPSASSIST_VERIFICATION_WINDOWS=3
OPSASSIST_DATA_DIR=/workspace/data
OPSASSIST_AUTO_CREATE_SCHEMA=true

# Auth0 Organizations provide the tenant boundary. Production must set these
# and OPSASSIST_AUTH_REQUIRED=true.
OPSASSIST_AUTH_REQUIRED=false
OPSASSIST_AUTH0_DOMAIN=your-tenant.us.auth0.com
OPSASSIST_AUTH0_AUDIENCE=https://api.opsassist.ai
OPSASSIST_AUTH0_ROLES_CLAIM=https://opsassist.ai/roles
OPSASSIST_AUTH0_PERMISSIONS_CLAIM=permissions
OPSASSIST_AUTH0_TENANT_CLAIM=org_id

# Redis-backed distributed rate limits and observability exporters.
OPSASSIST_REDIS_URL=redis://redis:6379/0
OPSASSIST_RATE_LIMIT_PER_MINUTE=120
OPSASSIST_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OPSASSIST_SENTRY_DSN=

# Use sentence_transformer for real MiniLM + FAISS indexing. The default TF-IDF
# backend is smaller and fully offline when model weights are not installed.
OPSASSIST_EMBEDDING_BACKEND=tfidf
OPSASSIST_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPSASSIST_INDEX_DIR=/indexes
OPSASSIST_RETRIEVAL_SERVICE_URL=http://indexer:8080
OPSASSIST_INDEXER_SHARED_KEY=replace-with-a-long-random-value
