{
  "title": "OpsAssist Production Overview",
  "uid": "opsassist-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {"type":"timeseries","title":"Request rate","gridPos":{"x":0,"y":0,"w":12,"h":8},"targets":[{"expr":"sum(rate(opsassist_http_requests_total[5m])) by (route)","legendFormat":"{{route}}"}]},
    {"type":"timeseries","title":"p95 latency","gridPos":{"x":12,"y":0,"w":12,"h":8},"targets":[{"expr":"histogram_quantile(0.95, sum(rate(opsassist_http_request_duration_seconds_bucket[5m])) by (le, route))","legendFormat":"{{route}}"}]},
    {"type":"stat","title":"Agent failures (1h)","gridPos":{"x":0,"y":8,"w":8,"h":6},"targets":[{"expr":"sum(increase(opsassist_agent_failures_total[1h]))"}]},
    {"type":"stat","title":"5xx rate","gridPos":{"x":8,"y":8,"w":8,"h":6},"targets":[{"expr":"sum(rate(opsassist_http_requests_total{status=~\"5..\"}[5m]))"}]}
  ]
}
